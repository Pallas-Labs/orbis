{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vite/**", "out/**", "*.tsbuildinfo"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [".cache/typecheck.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@orbis/api#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/server/drizzle/**"],
      "outputs": ["dist/**", ".vite/**", "out/**", "*.tsbuildinfo"]
    },
    "@orbis/api#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/server/drizzle/**"],
      "outputs": []
    },
    "@orbis/web#test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "diagnostics": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "doctor": {
      "cache": false
    },
    "//#lint": {
      "dependsOn": ["@orbis/contracts#build"],
      "outputs": []
    },
    "//#bounded-reads": {
      "outputs": []
    },
    "//#hosts": {
      "cache": false
    },
    "//#fence": {
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "//#tokens:check": {
      "outputs": []
    },
    "//#flags:check": {
      "outputs": []
    },
    "//#test:scripts": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": ["ORBIS_DATA_DIR"],
  "globalDependencies": ["tsconfig.base.json"]
}
