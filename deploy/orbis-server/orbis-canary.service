[Unit]
Description=Orbis download canary
After=network-online.target
# Each uncached start spends a 1Password read.
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=%h/orbis-service/apps/server
Environment=ORBIS_DATA_DIR=%h/orbis-service-data
Environment=ORBIS_YTDLP_BIN=%h/.local/bin/yt-dlp
Environment=ORBIS_OTLP_LOGS_URL=http://127.0.0.1:4318/v1/logs
# yt-dlp needs Deno, which uv installs beside it.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
# Provider settings and keys come from 1Password through apps/server/.env.schema.
ExecStart=%h/.local/share/mise/shims/varlock run -- %h/.local/share/mise/installs/bun/1.4.4/bin/bun src/canary.ts
