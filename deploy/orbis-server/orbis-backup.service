[Unit]
Description=Orbis nightly database backup

[Service]
Type=oneshot
# Holds ORBIS_BACKUP_DEST, ORBIS_DATA_DIR, and ORBIS_GROUP_API_URL. Create it once; see the README.
EnvironmentFile=%h/.config/orbis-backup.env
# ORBIS_NODE_KEY comes from 1Password through apps/server/.env.schema.
ExecStart=%h/.local/share/mise/shims/varlock run --path %h/orbis-service/apps/server/ -- %h/orbis-service/deploy/orbis-server/orbis-backup.sh
