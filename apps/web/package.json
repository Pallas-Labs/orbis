{
  "name": "@orbis/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "doctor": "bunx react-doctor@0.9.18 . --scope changed --base origin/main --blocking error --no-telemetry --yes",
    "deploy": "bun ../api/scripts/migrations.ts --check && alchemy deploy --stage prod",
    "destroy": "alchemy destroy --stage prod",
    "test": "vite build && node e2e/run.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@orbis/contracts": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "ai": "^7.0.116",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "input-otp": "1.5.0",
    "media-chrome": "4.19.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@stylexjs/unplugin": "0.19.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "6.1.1",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "tailwindcss": "4.3.3",
    "unplugin": "2.3.11",
    "vite": "8.3.1"
  }
}
