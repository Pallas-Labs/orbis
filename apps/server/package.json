{
  "name": "@orbis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/node.ts",
    "bench:sets": "bun src/bench-sets.ts",
    "backfill:artwork": "bun src/backfill-artwork.ts",
    "backfill:details": "bun src/backfill-details.ts",
    "backfill:tracklists": "bun src/backfill-tracklists.ts",
    "build": "bun build src/node.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/node.js",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .cache/typecheck.tsbuildinfo",
    "test": "bun test --timeout 60000",
    "test:update": "bun test --timeout 60000 --update-snapshots",
    "trust": "bun src/trust.ts",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json --format text",
    "eval": "evalite run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "node": "bun src/node.ts",
    "record:apple-music": "bun src/record-apple-music-album.ts"
  },
  "dependencies": {
    "@effect/ai-openrouter": "4.0.0-rc.117",
    "@effect/sql-sqlite-bun": "4.0.0-rc.117",
    "@orbis/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "effect": "4.0.0-rc.117",
    "evlog": "2.28.1",
    "jpeg-js": "0.4.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.2",
    "@types/opentype.js": "^1.3.10",
    "@varlock/1password-plugin": "^2.0.5",
    "drizzle-kit": "1.0.0-rc.5-5935859",
    "opentype.js": "1.3.4"
  }
}
