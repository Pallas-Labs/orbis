# Environment of orbis-server, orbis-canary, and the Orbis deploy on Vanta.
# Run them with `varlock run -- <cmd>` from this directory. Secrets resolve
# from the 1Password vault "Vanta Services"; no file holds their values.
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, useCliWithServiceAccount=true, cacheTtl=1h)
# @defaultSensitive=true @defaultRequired=true
# ---
# @type=opServiceAccountToken
OP_TOKEN=exec(`cat ~/.config/op/service-accounts/vanta-services.token`)

# Cobalt listens on Vanta's tailnet address, read at run time so no file holds it.
# The exec fails when tailscale gives no address, so the server does not start
# with `http://:9000`; the unit's Restart=on-failure tries again. Varlock reads
# a bare `$name` as a reference to another item, so the shell variable is `\$ip`.
# @sensitive=false
ORBIS_COBALT_URL=exec(`ip=$(tailscale ip -4) && [ -n "\$ip" ] && printf 'http://%s:9000' "\$ip"`)
# @sensitive=false
ORBIS_TITLE_MODEL=google/gemini-2.5-flash-lite

ORBIS_YOUTUBE_API_KEY=op("op://Vanta Services/orbis-youtube/credential")
ORBIS_COBALT_API_KEY=op("op://Vanta Services/orbis-cobalt/credential")
ORBIS_OPENROUTER_API_KEY=op("op://Vanta Services/orbis-openrouter/credential")
ORBIS_NODE_KEY=op("op://Vanta Services/orbis-node/credential")
